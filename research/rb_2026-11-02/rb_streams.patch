+@dataclass(frozen=True)
+class ExtTraj:
+    """A trajectory from outside the release (2026-10-28, RealPDEBench foil study).
+
+    Same interface as Traj for the GPU sampler, but its file lives in its own
+    directory and it never passes through ``partition``: no fold holdout applies to
+    data that is not ours. Competition rules forbid it in any submission.
+    """
+    re: int
+    aoa: int
+    file: str
+
+    @property
+    def stem(self) -> str:
+        return f"{self.re}_{self.aoa}"
+
+    def path(self, split: str) -> str:
+        return self.file
+
+
+def external(d: str) -> list[ExtTraj]:
+    out = []
+    for fn in sorted(os.listdir(d)):
+        if fn.endswith(".h5"):
+            re_s, aoa_s = fn[:-3].split("_")
+            out.append(ExtTraj(int(re_s), int(aoa_s), os.path.join(d, fn)))
+    return out
+
